"""
EXP 23 – Neural Network (Spiral Data, Sigmoid Activation)
"""

import numpy as np
from sklearn.neural_network import MLPClassifier

t = np.linspace(0, 4 * np.pi, 100)
x1 = t * np.cos(t)
x2 = t * np.sin(t)
X = np.column_stack((x1, x2))
y = (t > 2 * np.pi).astype(int)

model = MLPClassifier(hidden_layer_sizes=(3, 3, 3),
                      activation='logistic',
                      learning_rate_init=0.1,
                      max_iter=500)

model.fit(X, y)

print("Accuracy:", model.score(X, y))
